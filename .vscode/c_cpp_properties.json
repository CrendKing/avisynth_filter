{
    "version": 4,
    "configurations": [
        {
            "name": "AviSynth Filter",
            "includePath": [
                "${workspaceFolder}/avisynth_filter/src",
                "${workspaceFolder}/filter_common/src",
                "${workspaceFolder}/baseclasses/src",
                "${workspaceFolder}/dep_avisynth_plus/include",
                "${workspaceFolder}/dep_simpleini"
            ],
            "defines": [
                "AVSF_AVISYNTH",
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "WIN32",
                "_WINDOWS",
                "_USRDLL"
            ],
            "forcedInclude": [
                "${workspaceFolder}/filter_common/src/pch.h"
            ],
            "cppStandard": "c++20"
        },
        {
            "name": "VapourSynth Filter",
            "includePath": [
                "${workspaceFolder}/vapoursynth_filter/src",
                "${workspaceFolder}/filter_common/src",
                "${workspaceFolder}/baseclasses/src",
                "${workspaceFolder}/dep_vapoursynth",
                "${workspaceFolder}/dep_simpleini"
            ],
            "defines": [
                "AVSF_VAPOURSYNTH",
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "WIN32",
                "_WINDOWS",
                "_USRDLL"
            ],
            "forcedInclude": [
                "${workspaceFolder}/filter_common/src/pch.h"
            ],
            "cppStandard": "c++20"
        }
    ]
}
